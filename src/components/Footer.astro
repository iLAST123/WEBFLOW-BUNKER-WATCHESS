---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a href={base} class="footer-logo">BUNKER WATCHES</a>
        <p class="footer-tagline">Timeless Luxury &amp; Precision</p>
      </div>
      <div class="footer-nav-cols">
        <div class="footer-col">
          <p class="footer-col-title">Site</p>
          <a href={base} class="footer-link">Home</a>
          <a href={`${base}watches`} class="footer-link">Coleção</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">Contato</p>
          <a
            href="https://wa.me/5511946094089"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
          <a href="tel:+5511946094089" class="footer-link">+11 94609-4089</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">© {year} Bunker Watches. Todos os direitos reservados.</span>
      <span class="footer-swiss">Swiss Craftsmanship</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #050505;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 72px 0 56px;
    gap: 60px;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .footer-logo {
    display: block;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-size: 13px;
    font-weight: 300;
    font-style: italic;
    color: rgba(255,255,255,0.3);
    margin: 0;
    font-family: 'Merriweather', serif;
  }

  .footer-nav-cols {
    display: flex;
    gap: 80px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col-title {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
    margin: 0 0 4px;
  }

  .footer-link {
    font-size: 13px;
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-link:hover { color: #fff; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 12px;
    color: rgba(255,255,255,0.2);
  }

  .footer-swiss {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.15);
  }

  @media (max-width: 767px) {
    .footer-inner { padding: 0 24px; }
    .footer-top { flex-direction: column; gap: 40px; }
    .footer-nav-cols { gap: 40px; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 8px; }
  }
</style>

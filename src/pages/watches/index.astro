---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const watches = [
  {
    name: "GMT Master II",
    ref: "126710BLRO",
    description: "Ícone da relojoaria suíça com exibição de dois fusos horários simultâneos. Bisel Cerachrom bidirecional, movimento Calibre 3285 com aproximadamente 70 horas de reserva de marcha.",
    image: "https://cdn.prod.website-files.com/698c7ba56e1347e45bd9baf8/698c7be9af43dd63e01a1a91_transferir.jpg",
    slug: "gmt-master-2",
    material: "Oystersteel",
    diameter: "40mm",
  },
];
---

<Layout title="Coleção — Bunker Watches" description="Explore nossa coleção exclusiva de relógios de luxo suíços. Autenticidade garantida e atendimento personalizado.">
  <Nav active="watches" />

  <main class="page-main">
    <!-- Header -->
    <header class="page-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={base} class="bc-link">Home</a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <span class="bc-current">Coleção</span>
        </nav>
        <p class="section-label">Catálogo Exclusivo</p>
        <h1 class="page-title">Nossa Coleção</h1>
        <p class="page-subtitle">
          Relógios de alto padrão, cuidadosamente selecionados para os mais exigentes colecionadores.
          Cada peça é verificada e acompanhada de certificado de autenticidade.
        </p>
      </div>
    </header>

    <div class="divider"></div>

    <!-- Grid -->
    <section class="watches-section">
      <div class="container">
        <div class="watches-count">
          <span>{watches.length} {watches.length === 1 ? 'peça disponível' : 'peças disponíveis'}</span>
        </div>
        <div class="watches-grid">
          {watches.map((w) => (
            <a href={`${base}watches/${w.slug}`} class="watch-card">
              <div class="watch-card-image">
                <img src={w.image} alt={w.name} loading="lazy" />
                <div class="watch-card-overlay">
                  <span>Ver Detalhes</span>
                </div>
                <div class="watch-card-badges">
                  <span class="badge">Autêntico</span>
                </div>
              </div>
              <div class="watch-card-body">
                <div class="watch-meta-row">
                  <span class="watch-material">{w.material}</span>
                  <span class="watch-diameter">{w.diameter}</span>
                </div>
                <div class="watch-card-title-row">
                  <h2 class="watch-name">{w.name}</h2>
                  <span class="watch-ref">Ref. {w.ref}</span>
                </div>
                <p class="watch-desc">{w.description}</p>
                <div class="watch-card-footer">
                  <span class="watch-cta">Ver Detalhes →</span>
                  <span class="watch-whatsapp-hint">Consultar via WhatsApp</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container cta-inner">
      <div>
        <p class="section-label">Não encontrou o que procurava?</p>
        <h2 class="section-heading" style="margin-bottom: 8px;">Atendimento Personalizado</h2>
        <p class="body-text" style="margin: 0;">Nossa equipe pode ajudar a encontrar o relógio ideal para você.</p>
      </div>
      <a
        href="https://wa.me/5511946094089?text=Olá! Gostaria de saber mais sobre a coleção Bunker Watches."
        class="btn-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Falar no WhatsApp
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-main { padding-top: 72px; }

  .page-header {
    padding: 80px 0 64px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
  }

  .bc-link {
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    transition: color 0.2s;
  }

  .bc-link:hover { color: rgba(255,255,255,0.7); }

  .bc-sep {
    font-size: 12px;
    color: rgba(255,255,255,0.15);
  }

  .bc-current {
    font-size: 12px;
    color: rgba(255,255,255,0.65);
  }

  .page-title {
    font-family: 'Merriweather', serif;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    line-height: 1.1;
    color: #fff;
    margin: 0 0 20px;
  }

  .page-subtitle {
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    margin: 0;
    max-width: 580px;
  }

  /* Watches section */
  .watches-section {
    padding: 64px 0 120px;
  }

  .watches-count {
    margin-bottom: 32px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.25);
    text-transform: uppercase;
  }

  .watches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 24px;
  }

  .watch-card {
    display: block;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    transition: border-color 0.3s;
  }

  .watch-card:hover { border-color: rgba(255,255,255,0.14); }

  .watch-card-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(255,255,255,0.02);
  }

  .watch-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .watch-card:hover .watch-card-image img { transform: scale(1.05); }

  .watch-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .watch-card-overlay span {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 10px 24px;
  }

  .watch-card:hover .watch-card-overlay { opacity: 1; }

  .watch-card-badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    gap: 8px;
  }

  .badge {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
    background: rgba(0,0,0,0.65);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 5px 10px;
    backdrop-filter: blur(4px);
  }

  .watch-card-body {
    padding: 28px 32px 32px;
  }

  .watch-meta-row {
    display: flex;
    gap: 16px;
    margin-bottom: 12px;
  }

  .watch-material,
  .watch-diameter {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.25);
  }

  .watch-material::after {
    content: '·';
    margin-left: 16px;
    color: rgba(255,255,255,0.15);
  }

  .watch-card-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .watch-name {
    font-family: 'Merriweather', serif;
    font-size: 22px;
    font-weight: 300;
    color: #fff;
    margin: 0;
  }

  .watch-ref {
    font-size: 10px;
    color: rgba(255,255,255,0.2);
    white-space: nowrap;
  }

  .watch-desc {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(255,255,255,0.45);
    margin: 0 0 24px;
  }

  .watch-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .watch-cta {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.4);
    transition: color 0.2s;
  }

  .watch-card:hover .watch-cta { color: rgba(255,255,255,0.85); }

  .watch-whatsapp-hint {
    font-size: 10px;
    color: rgba(37, 211, 102, 0.6);
    letter-spacing: 0.06em;
  }

  /* CTA Banner */
  .cta-banner {
    background: rgba(255,255,255,0.015);
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 80px 0;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  @media (max-width: 767px) {
    .watches-grid { grid-template-columns: 1fr; }
    .watch-card-body { padding: 20px 24px 24px; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>

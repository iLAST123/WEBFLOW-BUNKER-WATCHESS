---
import Layout from '../../layouts/Layout.astro';

const watches = [
  {
    name: "GMT Master 2",
    description: "Um ícone da relojoaria suíça, o GMT Master II é reconhecido por sua capacidade de exibir dois fusos horários simultaneamente. Com seu bisel giratório bidirecional e mostrador meticulosamente trabalhado, este relógio é a escolha dos viajantes mais exigentes.",
    image: "https://cdn.prod.website-files.com/698c7ba56e1347e45bd9baf8/698c7be9af43dd63e01a1a91_transferir.jpg",
    slug: "gmt-master-2",
    color: "#8b0000",
  },
];
---

<Layout title="Coleção Rolex - Bunker Watches">
  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-container">
      <a href="/" class="nav-logo">BUNKER WATCHES</a>
      <div class="nav-links">
        <a href="/watches" class="nav-link active">Coleção</a>
        <a href="/#about" class="nav-link">Sobre</a>
        <a href="/#contact" class="nav-link">Contato</a>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="container">
      <p class="section-label">Catálogo</p>
      <h1 class="page-title">Nossa Coleção</h1>
      <p class="page-subtitle">Relógios de alto padrão, cuidadosamente selecionados para os mais exigentes colecionadores.</p>
    </div>
  </header>

  <div class="section-divider"></div>

  <!-- Watches Grid -->
  <section class="collection-section">
    <div class="container">
      <div class="watches-grid">
        {watches.map((watch) => (
          <a href={`/watches/${watch.slug}`} class="watch-card">
            <div class="watch-image-wrap">
              <img src={watch.image} alt={watch.name} class="watch-image" />
            </div>
            <div class="watch-info">
              <h2 class="watch-name">{watch.name}</h2>
              <p class="watch-desc">{watch.description.slice(0, 150)}...</p>
              <span class="watch-cta">Ver Detalhes →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <span class="footer-brand">BUNKER WATCHES</span>
      <span class="footer-copy">© {new Date().getFullYear()} Bunker Watches. Todos os direitos reservados.</span>
    </div>
  </footer>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  @media (max-width: 767px) {
    .container { padding: 0 24px; }
  }

  /* Nav */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 24px 0;
    background: rgba(10,10,10,0.95);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
  }

  .nav-links { display: flex; gap: 40px; }

  .nav-link {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    transition: color 0.2s;
  }

  .nav-link:hover, .nav-link.active { color: #fff; }

  @media (max-width: 767px) {
    .nav-container { padding: 0 24px; }
    .nav-links { gap: 20px; }
  }

  /* Page Header */
  .page-header {
    padding: 160px 0 80px;
  }

  .section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 16px;
  }

  .page-title {
    font-family: 'Merriweather', serif;
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 20px;
  }

  .page-subtitle {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
    margin: 0;
    max-width: 560px;
  }

  .section-divider {
    width: 100%;
    height: 1px;
    background: rgba(255,255,255,0.06);
  }

  /* Collection */
  .collection-section {
    padding: 80px 0 120px;
  }

  .watches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .watch-card {
    display: block;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06);
    transition: border-color 0.3s, background 0.3s;
    overflow: hidden;
  }

  .watch-card:hover {
    border-color: rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.04);
  }

  .watch-image-wrap {
    overflow: hidden;
    aspect-ratio: 4/3;
    background: rgba(255,255,255,0.03);
  }

  .watch-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .watch-card:hover .watch-image { transform: scale(1.04); }

  .watch-info { padding: 32px; }

  .watch-name {
    font-family: 'Merriweather', serif;
    font-size: 24px;
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .watch-desc {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
    margin: 0 0 20px;
  }

  .watch-cta {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    transition: color 0.2s;
  }

  .watch-card:hover .watch-cta { color: #ffffff; }

  /* Footer */
  .footer {
    padding: 40px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-brand {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
  }

  .footer-copy {
    font-size: 12px;
    color: rgba(255,255,255,0.3);
  }
</style>

---
import Layout from '../layouts/Layout.astro';

const watches = [
  {
    name: "GMT Master 2",
    description: "Um ícone da relojoaria suíça, o GMT Master II é reconhecido por sua capacidade de exibir dois fusos horários simultaneamente. Com seu bisel giratório bidirecional e mostrador meticulosamente trabalhado, este relógio é a escolha dos viajantes mais exigentes.",
    image: "https://cdn.prod.website-files.com/698c7ba56e1347e45bd9baf8/698c7be9af43dd63e01a1a91_transferir.jpg",
    slug: "gmt-master-2",
    color: "#8b0000",
  },
];
---

<Layout title="Bunker Watches - Luxury Timepieces & Swiss Craftsmanship">
  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-container">
      <a href="/" class="nav-logo">BUNKER WATCHES</a>
      <div class="nav-links">
        <a href="/watches" class="nav-link">Coleção</a>
        <a href="#about" class="nav-link">Sobre</a>
        <a href="#contact" class="nav-link">Contato</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">Relojoaria de Luxo</p>
      <h1 class="hero-title">BUNKER<br />WATCHES</h1>
      <p class="hero-subtitle">Timeless Luxury &amp; Precision</p>
      <a href="/watches" class="btn-outline">Ver Coleção</a>
    </div>
    <div class="hero-decoration">
      <div class="hero-circle"></div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider"></div>

  <!-- About Section -->
  <section class="about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <p class="section-label">Nossa História</p>
          <h2 class="section-title">Timeless Elegance</h2>
          <p class="body-text">
            Handcrafted Swiss timepieces that define luxury and precision. Each watch tells a unique story of craftsmanship, combining centuries of horological tradition with modern design innovation.
          </p>
          <p class="body-text">
            Na Bunker Watches, acreditamos que um relógio de alto padrão vai além de simplesmente marcar o tempo — é uma expressão de identidade, um legado que atravessa gerações.
          </p>
          <a href="/watches" class="btn-outline" style="margin-top: 2rem; display: inline-block;">Explorar Coleção</a>
        </div>
        <div class="about-stats">
          <div class="stat">
            <span class="stat-number">50+</span>
            <span class="stat-label">Anos de Tradição</span>
          </div>
          <div class="stat">
            <span class="stat-number">100%</span>
            <span class="stat-label">Swiss Made</span>
          </div>
          <div class="stat">
            <span class="stat-number">∞</span>
            <span class="stat-label">Garantia de Qualidade</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Collection -->
  <section class="collection">
    <div class="container">
      <p class="section-label" style="text-align: center;">Destaques</p>
      <h2 class="section-title" style="text-align: center; margin-bottom: 3rem;">Coleção em Destaque</h2>
      <div class="watches-grid">
        {watches.map((watch) => (
          <a href={`/watches/${watch.slug}`} class="watch-card">
            <div class="watch-image-wrap">
              <img src={watch.image} alt={watch.name} class="watch-image" />
            </div>
            <div class="watch-info">
              <h3 class="watch-name">{watch.name}</h3>
              <p class="watch-desc">{watch.description.slice(0, 120)}...</p>
              <span class="watch-cta">Ver Detalhes →</span>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/watches" class="btn-outline">Ver Toda a Coleção</a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact" id="contact">
    <div class="container contact-inner">
      <p class="section-label">Entre em Contato</p>
      <h2 class="section-title">Fale Conosco</h2>
      <p class="body-text" style="max-width: 500px;">
        Tem dúvidas sobre nossa coleção ou deseja agendar uma consulta personalizada? Estamos disponíveis para atendê-lo.
      </p>
      <a href="https://wa.me/5511946094089" class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Chamar no WhatsApp: +11 94609-4089
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <span class="footer-brand">BUNKER WATCHES</span>
      <span class="footer-copy">© {new Date().getFullYear()} Bunker Watches. Todos os direitos reservados.</span>
    </div>
  </footer>
</Layout>

<style>
  /* ---- Layout ---- */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  @media (max-width: 767px) {
    .container { padding: 0 24px; }
  }

  /* ---- Nav ---- */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 24px 0;
    background: linear-gradient(to bottom, rgba(10,10,10,0.95) 0%, transparent 100%);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
  }

  .nav-links {
    display: flex;
    gap: 40px;
  }

  .nav-link {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.65);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #fff;
  }

  @media (max-width: 767px) {
    .nav-container { padding: 0 24px; }
    .nav-links { gap: 20px; }
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 48px 80px;
    overflow: hidden;
  }

  .hero-content {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin: 0 0 24px;
  }

  .hero-title {
    font-family: 'Merriweather', serif;
    font-size: clamp(64px, 10vw, 120px);
    font-weight: 300;
    line-height: 1.0;
    letter-spacing: 0.04em;
    color: #ffffff;
    margin: 0 0 24px;
  }

  .hero-subtitle {
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.55);
    margin: 0 0 48px;
    font-style: italic;
    font-family: 'Merriweather', serif;
  }

  .hero-decoration {
    position: absolute;
    right: -200px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-circle {
    width: 700px;
    height: 700px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.05);
    background: radial-gradient(circle at center, rgba(255,255,255,0.02) 0%, transparent 70%);
  }

  /* ---- Buttons ---- */
  .btn-outline {
    display: inline-block;
    padding: 14px 36px;
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    transition: border-color 0.2s, background 0.2s;
  }

  .btn-outline:hover {
    border-color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.04);
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 36px;
    background: #25D366;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-top: 2rem;
    transition: background 0.2s;
  }

  .btn-whatsapp:hover {
    background: #1da851;
    color: #fff;
  }

  /* ---- Divider ---- */
  .section-divider {
    width: 100%;
    height: 1px;
    background: rgba(255,255,255,0.06);
  }

  /* ---- Section labels ---- */
  .section-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 16px;
  }

  .section-title {
    font-family: 'Merriweather', serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 24px;
  }

  .body-text {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(255,255,255,0.65);
    margin: 0 0 16px;
    max-width: 540px;
  }

  /* ---- About ---- */
  .about {
    padding: 120px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-stats {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-left: 40px;
    border-left: 1px solid rgba(255,255,255,0.08);
  }

  .stat-number {
    display: block;
    font-family: 'Merriweather', serif;
    font-size: 52px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }

  @media (max-width: 991px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .about-stats {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 48px;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 40px;
    }
  }

  /* ---- Collection ---- */
  .collection {
    padding: 120px 0;
    background: rgba(255,255,255,0.015);
  }

  .watches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2px;
  }

  .watch-card {
    display: block;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06);
    transition: border-color 0.3s, background 0.3s;
    overflow: hidden;
  }

  .watch-card:hover {
    border-color: rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.04);
  }

  .watch-image-wrap {
    overflow: hidden;
    aspect-ratio: 4/3;
    background: rgba(255,255,255,0.03);
  }

  .watch-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .watch-card:hover .watch-image {
    transform: scale(1.04);
  }

  .watch-info {
    padding: 32px;
  }

  .watch-name {
    font-family: 'Merriweather', serif;
    font-size: 22px;
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 12px;
  }

  .watch-desc {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255,255,255,0.55);
    margin: 0 0 20px;
  }

  .watch-cta {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
  }

  .watch-card:hover .watch-cta {
    color: #ffffff;
  }

  /* ---- Contact ---- */
  .contact {
    padding: 120px 0;
  }

  .contact-inner {
    max-width: 700px;
  }

  /* ---- Footer ---- */
  .footer {
    padding: 40px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-brand {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
  }

  .footer-copy {
    font-size: 12px;
    color: rgba(255,255,255,0.3);
  }
</style>
